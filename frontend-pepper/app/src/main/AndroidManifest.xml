<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:name=".PepperApplication"
        android:icon="@android:drawable/ic_dialog_info"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <activity android:name=".ResearcherSetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".WelcomeActivity" android:exported="false" />
        <activity android:name=".CoreInfoActivity" android:exported="false" />
        <activity android:name=".ModeSelectActivity" android:exported="false" />
        <activity android:name=".ChatActivity" android:exported="false" />
        <activity android:name=".AvatarChatActivity" android:exported="false" />
        <activity android:name=".ClosingActivity" android:exported="false" />

    </application>

</manifest>
